# Base URL for invoking Supabase Edge Functions (no trailing slash)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
STOCK_VIEW_NAME=warehouse_stock_current

# Stock API (server-side only — never expose token to the browser)
STOCK_CONTROL_ENABLED=false
STOCK_CATALOG_SYNC_ENABLED=false
STOCK_CATALOG_SYNC_DEACTIVATE_MISSING=false
STOCK_CATALOG_SYNC_DELETE_MISSING=true
STOCK_CATALOG_SYNC_API_URL=https://afterten-stock-api-896827614552.us-central1.run.app/sync/catalog
STOCK_SYNC_API_URL=https://afterten-stock-api-896827614552.us-central1.run.app/sync/stock
STOCK_SYNC_API_TOKEN=

# Firebase (set CLOUD_BACKEND=firebase to use Firestore for POS middleware + orders APIs)
CLOUD_BACKEND=firebase
NEXT_PUBLIC_CLOUD_BACKEND=firebase
FIREBASE_PROJECT_ID=afterten-portal-system
NEXT_PUBLIC_FIREBASE_PROJECT_ID=afterten-portal-system
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=afterten-portal-system.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_CREDENTIALS_PATH=C:\Projects\Afterten\secrets\afterten-firebase-adminsdk.json
# On Vercel, paste the full service-account JSON (single line) instead of using a file path:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
