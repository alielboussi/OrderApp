# supabase | firebase (migration target: supabase)
CLOUD_BACKEND=supabase
NEXT_PUBLIC_CLOUD_BACKEND=supabase

STOCK_VIEW_NAME=warehouse_stock_current

# Supabase (server-side only — service role never in browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stock API (server-side only — never expose token to the browser)
# BILLING SAFETY: portal sync is hardcoded OFF in src/lib/stock-catalog-sync.ts.
# Env alone cannot re-enable it. See docs/billing-cost-guards.md
STOCK_CONTROL_ENABLED=false
STOCK_CATALOG_SYNC_ENABLED=false
STOCK_CATALOG_SYNC_DEACTIVATE_MISSING=false
STOCK_CATALOG_SYNC_DELETE_MISSING=false
STOCK_CATALOG_SYNC_API_URL=https://afterten-stock-api-896827614552.us-central1.run.app/sync/catalog
STOCK_SYNC_API_URL=https://afterten-stock-api-896827614552.us-central1.run.app/sync/stock
STOCK_SYNC_API_TOKEN=

# MintPOS catalog import (mintpos-catalog-import-supabase.cjs — optional)
MINTPOS_DB_SERVER=
MINTPOS_DB_DATABASE=MINTPOS
MINTPOS_DB_USERNAME=
MINTPOS_DB_PASSWORD=
# MINTPOS_APPSETTINGS_PATH=C:\ProgramData\SCPGT\appsettings.json

# Outlet orders export API (server-side only — Bearer token for /api/outlet-orders/accepted)
# Generate with: node afterten-website-portal/scripts/generate-outlet-orders-api-key.mjs
OUTLET_ORDERS_API_BEARER_KEY=

# SCPGT middleware tokens are generated per-outlet (never commit exports/middleware-credentials/)

# Firebase
FIREBASE_PROJECT_ID=afterten-portal-system
NEXT_PUBLIC_FIREBASE_PROJECT_ID=afterten-portal-system
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=afterten-portal-system.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_CREDENTIALS_PATH=C:\Projects\Afterten\secrets\afterten-firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=afterten-portal-system-catalog-images
# On Vercel, paste the full service-account JSON (single line) instead of using a file path:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
